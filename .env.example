# Copy this file to .env and adjust values as needed
# Database (MySQL for local development)
MYSQL_LOAN_ROOT_PASSWORD=loanroot
MYSQL_LOAN_DATABASE=loan_db
MYSQL_LOAN_USER=loan_user
MYSQL_LOAN_PASSWORD=loan_pass
MYSQL_LOAN_PORT=3308

# Application ports
LOAN_SERVICE_PORT=8080
ADMINER_LOAN_PORT=8083

# CORS
CORS_ALLOWED_LOAN_ORIGINS=*

# Security / JWT (for local tests)
JWT_LOAN_SECRET=changeme
JWT_LOAN_EXPIRATION=3600
JWT_LOAN_ISSUER=crediya

# Optional: If you run IAM locally alongside, set the URL here; leave empty otherwise
# Example: http://localhost:8090
ADAPTER_RESTCONSUMER_URL=
